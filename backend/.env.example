# Copie este archivo a backend/.env y complete los valores. backend/.env nunca
# se commitea (.gitignore).

# PostgreSQL (Supabase, session pooler). El sufijo del driver no hace falta:
# adapters/db/session.py lo normaliza a psycopg3 (ADR-002).
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# URL del proyecto Supabase. El backend verifica los tokens de sesion contra
# su JWKS publico (ADR-006); no se necesita ningun secreto de JWT.
SUPABASE_URL=https://<ref>.supabase.co
