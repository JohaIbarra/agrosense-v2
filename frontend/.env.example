# Copie a frontend/.env.local (no se commitea: *.local en .gitignore).

# URL del backend para el proxy de desarrollo (vite.config.ts).
VITE_API_TARGET=http://127.0.0.1:8000

# Supabase Auth (E1). La clave "publishable" es publica por diseño: solo sirve
# para iniciar sesion. Los datos no se leen con ella — el unico camino a los
# datos es la API de AgroSense, y las tablas tienen RLS sin politicas.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
